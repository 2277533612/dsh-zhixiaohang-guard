{
  "name": "dsh-zhixiaohang-guard",
  "version": "1.3.0",
  "type": "module",
  "description": "DeepSeek Harness 插件：只对智小航做 10 RPM 排队节流，并在入路处把校外未连 VPN 时返回的 HTML/base64 乱码换成 <200 字符短提示（其它 provider 零影响）",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "./index.mjs",
    "./cordis.patch.yml",
    "./README.md",
    "./LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "rate-limit",
    "throttle",
    "rpm",
    "mojibake",
    "garbled",
    "zhixiaohang",
    "campus-network",
    "vpn"
  ],
  "author": "Mika",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2277533612/dsh-zhixiaohang-guard.git"
  },
  "homepage": "https://github.com/2277533612/dsh-zhixiaohang-guard#readme",
  "bugs": {
    "url": "https://github.com/2277533612/dsh-zhixiaohang-guard/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "meta": {
    "title": "智小航守卫",
    "description": "智小航专属 10 RPM 节流 + 校外乱码入路屏蔽（其它 provider 零影响）"
  },
  "packageManager": "pnpm@11.7.0"
}
